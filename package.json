{
  "name": "dsh-weekly-digest",
  "version": "0.1.0",
  "description": "周报生成器（Weekly Digest）：聚合最近 N 天的 git 提交、DSH 会话活动与每日记忆，自动生成 Markdown 周报。全程只读。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "setup": "node scripts/setup-dsh-deps.mjs",
    "build": "./scripts/build.sh",
    "build:win": "node scripts/build-win.mjs",
    "typecheck": "node scripts/setup-dsh-deps.mjs && tsc -p tsconfig.json --noEmit --pretty false",
    "test": "node --test 'tests/*.test.ts'"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "BSD-3-Clause"
}
